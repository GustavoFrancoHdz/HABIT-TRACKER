# =============================================================================
# HABIT TRACKER — Variables de entorno
# Copia este archivo a .env.local y rellena cada valor.
# .env.local está en .gitignore — nunca lo subas al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — proyecto de DESARROLLO
# Origen: Supabase Dashboard → Settings → API
# -----------------------------------------------------------------------------

# URL del proyecto (distinta para dev y prod)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública anónima (segura para exponer en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# -----------------------------------------------------------------------------
# Supabase — solo si usas la CLI para generar tipos (Tarea 04)
# Origen: Supabase Dashboard → Settings → General → Reference ID
# No es una variable que lea la app; la usa el script de generación de tipos.
# -----------------------------------------------------------------------------

# SUPABASE_PROJECT_REF=<project-ref>

# -----------------------------------------------------------------------------
# Servicios externos — extensión del núcleo
# Agrega aquí las llaves de cualquier API de terceros que la extensión requiera.
# Cada variable debe incluir un comentario que indique de dónde obtenerla.
# -----------------------------------------------------------------------------

# Ejemplo (descomentar y rellenar cuando aplique):
# NOMBRE_DEL_SERVICIO_API_KEY=<api-key>     # Origen: dashboard del servicio
